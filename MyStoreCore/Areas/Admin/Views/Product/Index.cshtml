@model List<MusicStore.Application.DTOs.Product.ProductDto>

@section Styles {
    <link rel="stylesheet" href="~/AdminCss/Product.css" asp-append-version="true" />
}

<div class="category-panel-container">

    <div class="panel-header-wrapper">
        <div class="header-title-section">
            <span class="panel-sub-title">MANAGEMENT</span>
            <h2 class="panel-main-title">Products</h2>
        </div>
        <a asp-action="Create" class="btn-create-category">
            <i class="bi bi-plus-lg"></i>
            <span>Add New Product</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success category-alert" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger category-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

@if (TempData["Success"] != null)
{
        <div class="alert alert-success category-alert" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@TempData["Success"]</div>
        </div>
}

@if (TempData["Error"] != null)
{
        <div class="alert alert-danger category-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@TempData["Error"]</div>
        </div>
}

<br />

    <div class="mb-4">

        <form asp-action="Index"
              method="get">


            <div class="row g-3">
                <div class="col-md-4">

                    <input type="text"
                           name="Search"
                           class="form-control"
                           placeholder="Search product..."
                           value="@Context.Request.Query["Search"]" />

                </div>

                <div class="col-md-2">

                    <select name="CategoryId"
                            class="form-select">

                        <option value="">
                            All Categories
                        </option>

                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Id"
                                    selected="@(Context.Request.Query["CategoryId"] == category.Id.ToString())">

                                @category.Name

                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-2">

                    <select name="BrandId"
                            class="form-select">

                        <option value="">
                            All Brands
                        </option>


                        @foreach (var brand in ViewBag.Brands)
                        {
                            <option value="@brand.Id"
                                    selected="@(Context.Request.Query["BrandId"] == brand.Id.ToString())">

                                @brand.Name

                            </option>
                        }

                    </select>

                </div>
            </div>

            <div class="mt-3">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-filter"></i>
                    Apply Filter

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Clear

                </a>


            </div>
        </form>
    </div>

    <div class="premium-table-card">

        <div class="table-responsive-custom">

            <table class="table premium-custom-table align-middle">

                <thead>
                    <tr>
                        <th scope="col" style="width: 80px;">Image</th>
                        <th scope="col">Product Info</th>
                        <th scope="col" class="text-center">Category</th>
                        <th scope="col" class="text-center">Brand</th>
                        <th scope="col" class="text-center">Price</th>
                        <th scope="col" class="text-center">Stock</th>
                        <th scope="col" class="text-center">Status</th>
                        <th scope="col" class="text-end" style="width: 150px;">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td data-label="Image">

                                @if (!string.IsNullOrEmpty(item.MainImageUrl))
                                {
                                    <img src="@item.MainImageUrl"
                                         class="product-thumb"
                                         alt="@item.Name"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="product-thumb-empty">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }

                            </td>


                            <td data-label="Product">

                                <div class="brand-name">
                                    @item.Name
                                </div>

                                <small class="text-muted d-block mt-1">
                                    SKU: @item.SKU
                                </small>

                                <small class="text-danger d-block mt-1">
                                    CategoryId: @item.CategoryId
                                </small>

                                <small class="text-danger d-block">
                                    BrandId: @item.BrandId
                                </small>

                            </td>


                            <td data-label="Category" class="text-center">

                                <span class="badge-main-category">
                                    @item.CategoryName
                                </span>

                            </td>


                            <td data-label="Brand" class="text-center">

                                <span class="badge-country">
                                    @item.BrandName
                                </span>

                            </td>


                            <td data-label="Price" class="text-center">

                                <strong class="product-price">
                                    @item.Price.ToString("N2")
                                </strong>

                            </td>


                            <td data-label="Stock" class="text-center">

                                @if (item.StockQuantity == 0)
                                {
                                    <span class="badge bg-danger rounded-pill px-2.5">
                                        Out of Stock
                                    </span>
                                }
                                else if (item.StockQuantity <= 5)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-2.5">
                                        Low Stock (@item.StockQuantity)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-products">
                                        <i class="bi bi-box-seam"></i>
                                        <span>
                                            @item.StockQuantity
                                        </span>
                                    </span>
                                }

                            </td>


                            <td data-label="Status" class="text-center">

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <td data-label="Actions" class="text-end">

                                <div class="table-actions-wrapper">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn-table-action btn-edit"
                                       title="Edit Product">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>


                                    <a asp-controller="ProductImage"
                                       asp-action="Index"
                                       asp-route-productId="@item.Id"
                                       class="btn-table-action btn-image"
                                       title="Manage Images">

                                        <i class="bi bi-images"></i>

                                    </a>


                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn-table-action btn-delete"  
                                                title="Delete Product"
                                                onclick="return confirm('Are you sure you want to delete this product?')">

                                            <i class="bi bi-trash3"></i>

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
