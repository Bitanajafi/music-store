@model MusicStore.Application.DTOs.Stock.StockHistoryDto

@{
    ViewData["Title"] = "جزئیات تغییر موجودی";
}
@section Styles {
    <link rel="stylesheet"
          href="~/AdminCss/Stock.css"
          asp-append-version="true" />
}

<div class="container-fluid px-0">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold-custom mb-1 text-dark fs-4">
                جزئیات تغییر موجودی
            </h2>
            <p class="text-muted mb-0 fs-7">
                اطلاعات کامل رکورد تراکنش انبار
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Stock"
           asp-action="Index"
           class="btn-secondary-custom">
            <i class="bi bi-arrow-right"></i>
            <span>بازگشت</span>
        </a>
    </div>

    <div class="form-panel p-0 overflow-hidden" style="max-width: 800px;">

        <div class="details-card-header d-flex align-items-center justify-content-between">
            <span class="fw-bold-custom text-dark fs-6">
                اطلاعات رکورد
            </span>
            <span class="badge-custom-info">
                #@Model.Id
            </span>
        </div>

        <div class="p-4">
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="details-item-box">
                        <span class="details-label">نام محصول</span>
                        <div class="details-value d-flex align-items-center gap-2">
                            <i class="bi bi-box-seam text-warning"></i>
                            <span>@Model.ProductName</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="details-item-box">
                        <span class="details-label">کد SKU</span>
                        <div class="details-value font-monospace">
                            @Model.SKU
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="details-item-box">
                        <span class="details-label">مقدار تغییر</span>
                        <div>
                            @if (Model.Quantity > 0)
                            {
                                <span class="status-dot success" style="direction: ltr;">
                                    +@Model.Quantity
                                </span>
                            }
                            else
                            {
                                <span class="status-dot danger" style="direction: ltr;">
                                    @Model.Quantity
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="details-item-box">
                        <span class="details-label">دلیل تغییر</span>
                        <div class="details-value">
                            @(string.IsNullOrWhiteSpace(Model.Reason) ? "---" : Model.Reason)
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="details-item-box">
                        <span class="details-label">ثبت‌کننده</span>
                        <div class="details-value">
                            @if (!string.IsNullOrWhiteSpace(Model.CreatedBy))
                            {
                                <span>
                                    <i class="bi bi-person me-1 text-warning"></i>
                                    @Model.CreatedByName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted fs-8">
                                    <i class="bi bi-cpu me-1"></i>سیستم
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="details-item-box">
                        <span class="details-label">تاریخ ثبت</span>
                        <div class="details-value font-monospace fs-8 text-muted">
                            @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd - HH:mm:ss")
                        </div>
                    </div>
                </div>

            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                <a asp-area="Admin"
                   asp-controller="Stock"
                   asp-action="ProductHistory"
                   asp-route-sku="@Model.SKU"
                   class="btn-action-minimalist warning py-2 px-3">
                    <i class="bi bi-clock-history"></i>
                    <span>تاریخچه این محصول</span>
                </a>

                <a asp-area="Admin"
                   asp-controller="Stock"
                   asp-action="Index"
                   class="btn-secondary-custom py-2 px-3">
                    انصراف
                </a>
            </div>
        </div>

    </div>

</div>