
@model IEnumerable<MusicStore.Application.DTOs.Stock.StockHistoryDto>

@{
    ViewData["Title"] = "تاریخچه انبار";
}

@section Styles {
    <link rel="stylesheet"
          href="~/AdminCss/Stock.css"
          asp-append-version="true" />
}

<div class="container-fluid px-0">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

        <div>
            <h2 class="fw-bold-custom mb-1 text-dark fs-4">
                مدیریت انبار
            </h2>

            <p class="text-muted mb-0 fs-7">
                تاریخچه تغییرات موجودی محصولات
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">

            @if (Model != null && Model.Any())
            {
                <span class="badge-custom-info me-2">
                    <i class="bi bi-box-seam"></i>
                    تعداد کل: @Model.Count()
                </span>
            }

            <a asp-area="Admin"
               asp-controller="Stock"
               asp-action="Increase"
               class="btn-submit-gold d-inline-flex align-items-center gap-2 text-decoration-none py-2 px-3">

                <i class="bi bi-plus-lg"></i>
                <span>افزایش موجودی</span>

            </a>

            <a asp-area="Admin"
               asp-controller="Stock"
               asp-action="Decrease"
               class="btn-action-minimalist danger py-2 px-3">

                <i class="bi bi-dash-lg"></i>
                <span>کاهش موجودی</span>

            </a>

        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <div class="premium-panel mb-4">

        <form asp-area="Admin"
              asp-controller="Stock"
              asp-action="Index"
              method="get"
              class="row g-3 align-items-end">

            <div class="col-md-8">
                <label for="sku" class="form-label fw-semibold">
                    جستجوی محصول با SKU
                </label>

                <input type="text"
                       id="sku"
                       name="sku"
                       value="@Context.Request.Query["sku"]"
                       class="form-control"
                       placeholder="کد SKU محصول را وارد کنید" />
            </div>

            <div class="col-md-2">
                <button type="submit"
                        class="btn-submit-gold w-100">
                    <i class="bi bi-search"></i>
                    جستجو
                </button>
            </div>

            <div class="col-md-2">
                <a asp-area="Admin"
                   asp-controller="Stock"
                   asp-action="Index"
                   class="btn-action-minimalist w-100 text-center">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    نمایش همه
                </a>
            </div>

        </form>

    </div>

    <div class="premium-panel">

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">

                <div class="mini-avatar mx-auto mb-3">
                    <i class="bi bi-inbox fs-4"></i>
                </div>

                <h6 class="fw-bold-custom">
                    هیچ رکوردی یافت نشد!
                </h6>

                <p class="text-muted fs-7 mb-0">
                    برای این محصول هنوز هیچ رکوردی در تاریخچه انبار ثبت نشده است.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive-custom">

                <table class="custom-premium-table align-middle">

                    <thead>
                        <tr>

                            <th scope="col"
                                class="text-center"
                                style="width: 90px;">
                                شناسه
                            </th>

                            <th scope="col">
                                محصول
                            </th>

                            <th scope="col"
                                class="text-center"
                                style="width: 120px;">
                                تعداد
                            </th>

                            <th scope="col">
                                دلیل
                            </th>

                            <th scope="col">
                                ثبت‌کننده
                            </th>

                            <th scope="col"
                                class="text-center"
                                style="width: 150px;">
                                تاریخ
                            </th>

                            <th scope="col"
                                class="text-end"
                                style="width: 200px;">
                                عملیات
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td data-label="شناسه"
                                    class="text-center fw-bold-custom text-muted">
                                    #@item.Id
                                </td>

                                <td data-label="محصول">

                                    <div class="d-flex align-items-center gap-2">

                                        <div>

                                            <div class="fw-bold-custom">
                                                @item.ProductName
                                            </div>

                                            <small class="text-muted font-monospace fs-8">
                                                SKU: @item.SKU
                                            </small>

                                        </div>

                                    </div>

                                </td>

                                <td data-label="تعداد"
                                    class="text-center">

                                    @if (item.Quantity > 0)
                                    {
                                        <span class="status-dot success"
                                              style="direction: ltr;">
                                            +@item.Quantity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-dot danger"
                                              style="direction: ltr;">
                                            @item.Quantity
                                        </span>
                                    }

                                </td>

                                <td data-label="دلیل">

                                    <span class="text-muted">
                                        @(string.IsNullOrWhiteSpace(item.Reason)? "---": item.Reason)
                                    </span>

                                </td>

                                <td data-label="ثبت‌کننده">

                                    <span class="fw-semibold">

                                        @if (item.CreatedBy == null)
                                        {
                                            <i class="bi bi-cpu me-1 text-secondary"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person me-1 text-warning"></i>
                                        }

                                        @item.CreatedByName

                                    </span>

                                </td>

                                <td data-label="تاریخ"
                                    class="text-center text-muted font-monospace fs-8">

                                    @item.CreatedAt.ToLocalTime()
                                    

                                </td>

                                <td data-label="عملیات"
                                    class="text-end">

                                    <div class="d-flex align-items-center justify-content-end gap-1">

                                        <a asp-area="Admin"
                                           asp-controller="Stock"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn-action-minimalist">

                                            <i class="bi bi-eye"></i>

                                            <span>
                                                جزئیات
                                            </span>

                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="Stock"
                                           asp-action="ProductHistory"
                                           asp-route-sku="@item.SKU"
                                           class="btn-action-minimalist warning">

                                            <i class="bi bi-clock-history"></i>

                                            <span>
                                                تاریخچه
                                            </span>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

