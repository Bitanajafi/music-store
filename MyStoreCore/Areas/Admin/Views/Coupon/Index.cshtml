@model IEnumerable<MusicStore.Application.DTOs.Coupon.CouponDto>

@{
    ViewData["Title"] = "مدیریت کدهای تخفیف";
}

@section Styles {
    <link rel="stylesheet" href="~/AdminCss/Coupon.css" asp-append-version="true" />
}

<div class="coupon-page" dir="rtl">

    <div class="d-flex justify-content-between align-items-end mb-4">
        <a asp-area="Admin"
           asp-controller="Coupon"
           asp-action="Create"
           class="btn-add-coupon">
            Add New Coupon +
        </a>

        <div class="text-end">
            <span class="coupon-subtitle-tag">MANAGEMENT</span>
            <h2 class="coupon-main-title">Coupons</h2>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 shadow-sm">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 mb-4 shadow-sm">
            @TempData["Error"]
        </div>
    }

    <div class="legato-card-table">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                هیچ کد تخفیفی یافت نشد.
            </div>
        }
        else
        {


            <br />

            <div class="Coupon-search-wrapper">

                <form asp-area="Admin"
                      asp-controller="Coupon"
                      asp-action="Index"
                      method="get"
                      class="Coupon-search-form">

                    <div class="Coupon-search-input-wrapper">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="Coupon-search-input"
                               placeholder="Search Coupon..." />

                    </div>


                    <button type="submit"
                            class="btn-Coupon-search">

                        Search

                    </button>


                    @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                    {
                        <a asp-area="Admin"
                           asp-controller="Coupon"
                           asp-action="Index"
                           class="btn-Coupon-clear">

                            Clear

                        </a>
                    }

                </form>

            </div>

            <br />




            <div class="table-responsive">
                <table class="table legato-table align-middle text-center mb-0">
                    <thead>
                        <tr>
                            <th class="text-start pe-4">COUPON</th>
                            <th>TYPE</th>
                            <th>VALUE</th>
                            <th>MIN ORDER</th>
                            <th>LIMIT</th>
                            <th>USED</th>
                            <th>EXPIRE DATE</th>
                            <th>STATUS</th>
                            <th class="text-start ps-4">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var coupon in Model)
                        {
                            <tr>
                                <td class="text-start pe-4 fw-bold text-dark">
                                    <i class="bi bi-ticket-perforated-fill me-2 text-muted"></i>
                                    @coupon.Code
                                </td>

                                <td>
                                    @if (coupon.DiscountType == MusicStore.Domain.Enum.DiscountType.Percentage)
                                    {
                                        <span class="legato-badge-dark">PERCENTAGE</span>
                                    }
                                    else
                                    {
                                        <span class="legato-badge-sub">FIXED AMOUNT</span>
                                    }
                                </td>

                                <td class="fw-bold text-dark">
                                    @if (coupon.DiscountType == MusicStore.Domain.Enum.DiscountType.Percentage)
                                    {
                                        <span>@coupon.Value%</span>
                                    }
                                    else
                                    {
                                        <span>@coupon.Value.ToString("N0")</span>
                                    }
                                </td>

                                <td>
                                    @if (coupon.MinimumOrderAmount.HasValue)
                                    {
                                        <span>@coupon.MinimumOrderAmount.Value.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (coupon.UsageLimit == 0)
                                    {
                                        <span class="text-muted">∞</span>
                                    }
                                    else
                                    {
                                        <span>@coupon.UsageLimit</span>
                                    }
                                </td>

                                <td>
                                    <span class="fw-semibold">@coupon.UsedCount</span>
                                </td>

                                <td class="small text-muted" dir="ltr">
                                    @coupon.ExpireDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                </td>

                                <td>
                                    @if (coupon.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">غیرفعال</span>
                                    }
                                </td>

                                <td class="text-start ps-4">
                                    <div class="d-flex align-items-center gap-1 justify-content-start">

                                        <form asp-area="Admin"
                                              asp-controller="Coupon"
                                              asp-action="Delete"
                                              asp-route-id="@coupon.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('آیا از حذف این کد تخفیف مطمئن هستید؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-legato-action btn-action-delete" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                        <a asp-area="Admin"
                                           asp-controller="Coupon"
                                           asp-action="Edit"
                                           asp-route-id="@coupon.Id"
                                           class="btn-legato-action btn-action-edit"
                                           title="ویرایش">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="Coupon"
                                              asp-action="ToggleActive"
                                              asp-route-id="@coupon.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn-legato-action btn-action-toggle"
                                                    title="@(coupon.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")">
                                                <i class="bi @(coupon.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>