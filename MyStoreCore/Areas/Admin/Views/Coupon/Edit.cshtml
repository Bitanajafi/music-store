@model MusicStore.Application.DTOs.Coupon.CreateCouponDto

@{
    ViewData["Title"] = "ویرایش کد تخفیف";
    var couponId = (int)ViewBag.CouponId;
}

@section Styles {
    <link rel="stylesheet" href="~/AdminCss/Coupon.css" asp-append-version="true" />
}

<div class="coupon-page" dir="rtl">

    <div class="d-flex justify-content-between align-items-end mb-4">
        <a asp-area="Admin"
           asp-controller="Coupon"
           asp-action="Index"
           class="btn-back-legato">
            <i class="bi bi-arrow-right me-1"></i> Back to Coupons
        </a>

        <div class="text-end">
            <span class="coupon-subtitle-tag">MANAGEMENT</span>
            <h2 class="coupon-main-title">Edit Coupon</h2>
        </div>
    </div>

    <div class="legato-form-card">
        <div class="legato-card-header">
            <h5 class="mb-0 fw-bold">اطلاعات کد تخفیف</h5>
        </div>

        <div class="legato-card-body">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 mb-4"></div>

            <form asp-area="Admin"
                  asp-controller="Coupon"
                  asp-action="Edit"
                  asp-route-id="@couponId"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Code" class="form-label legato-label">کد تخفیف</label>
                        <input asp-for="Code" class="form-control legato-input" placeholder="مثال: SUMMER2026" />
                        <span asp-validation-for="Code" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DiscountType" class="form-label legato-label">نوع تخفیف</label>
                        <select asp-for="DiscountType" class="form-select legato-input">
                            <option value="0">درصدی</option>
                            <option value="1">مبلغی (تومان)</option>
                        </select>
                        <span asp-validation-for="DiscountType" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Value" class="form-label legato-label">مقدار تخفیف</label>
                        <input asp-for="Value" type="number" step="0.01" class="form-control legato-input" placeholder="مثال: 20 یا 50000" />
                        <span asp-validation-for="Value" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MinimumOrderAmount" class="form-label legato-label">حداقل مبلغ سفارش (تومان)</label>
                        <input asp-for="MinimumOrderAmount" type="number" step="0.01" class="form-control legato-input" placeholder="اختیاری..." />
                        <span asp-validation-for="MinimumOrderAmount" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="UsageLimit" class="form-label legato-label">محدودیت تعداد استفاده</label>
                        <input asp-for="UsageLimit" type="number" min="0" class="form-control legato-input" placeholder="0 برای نامحدود" />
                        <span asp-validation-for="UsageLimit" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpireDate" class="form-label legato-label">تاریخ انقضا</label>
                        <input asp-for="ExpireDate" type="datetime-local" class="form-control legato-input" />
                        <span asp-validation-for="ExpireDate" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12">
                        <div class="legato-checkbox-wrapper">
                            <input asp-for="IsActive" class="form-check-input legato-checkbox" id="IsActiveCheck" />
                            <label asp-for="IsActive" class="form-check-label fw-bold ms-2" for="IsActiveCheck">
                                این کد تخفیف فعال و قابل استفاده باشد
                            </label>
                        </div>
                    </div>

                </div>

                <hr class="my-4 border-secondary opacity-10" />

                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn-legato-submit">
                        <i class="bi bi-check2-circle me-1"></i> ذخیره تغییرات
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}