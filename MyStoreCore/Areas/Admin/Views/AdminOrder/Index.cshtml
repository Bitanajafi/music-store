@model List<MusicStore.Application.DTOs.Order.OrderDto>
@using MusicStore.Domain.Enum

@section Styles {
    <link rel="stylesheet" href="~/AdminCss/Order.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "مدیریت سفارش‌ها";
}

<div class="order-page-wrapper" dir="rtl">

    <div class="order-header mb-4">
        <div>
            <h2 class="order-title">مدیریت سفارش‌ها</h2>
            <p class="order-subtitle">بررسی، ویرایش و وضعیت سفارشات مشتریان</p>
        </div>

        <div class="order-count-badge">
            <i class="bi bi-bag-check"></i>
            <span>تعداد کل سفارش‌ها: <strong>@(Model?.Count ?? 0) نفر</strong></span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success custom-alert mb-4" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger custom-alert mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <div class="order-card">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-state py-5 text-center">
                <div class="empty-icon mx-auto mb-3">
                    <i class="bi bi-inbox"></i>
                </div>
                <h5 class="empty-title mb-1">هیچ سفارشی ثبت نشده است</h5>
                <p class="text-muted small mb-0">در حال حاضر سفارشی برای نمایش وجود ندارد.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="order-table">
                    <thead>
                        <tr>
                            <th class="col-id">شناسه سفارش</th>
                            <th class="col-date">تاریخ ثبت</th>
                            <th class="col-items">تعداد کالا</th>
                            <th class="col-price">مبلغ کل</th>
                            <th class="col-status">وضعیت سفارش</th>
                            <th class="col-action">عملیات مدیریتی</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            string statusClass = order.Status switch
                            {
                                OrderStatus.Pending => "warning",
                                OrderStatus.Processing => "info",
                                OrderStatus.Shipped => "primary",
                                OrderStatus.Delivered => "success",
                                OrderStatus.Cancelled => "danger",
                                _ => "muted"
                            };

                            string statusText = order.Status switch
                            {
                                OrderStatus.Pending => "در انتظار پرداخت",
                                OrderStatus.Processing => "در حال پردازش",
                                OrderStatus.Shipped => "ارسال شده",
                                OrderStatus.Delivered => "تحویل شده",
                                OrderStatus.Cancelled => "لغو شده",
                                _ => order.Status.ToString()
                            };

                            <tr>
                                <td class="col-id">
                                    <div class="order-id-box">
                                        <span class="user-avatar-icon"><i class="bi bi-person"></i></span>
                                        <span class="order-id-text">#@order.Id</span>
                                    </div>
                                </td>

                                <td class="col-date">
                                    <span class="date-text">@order.CreatedAt.ToString("yyyy/MM/dd")</span>
                                </td>

                                <td class="col-items">
                                    <span class="badge-count">@(order.Items?.Count ?? 0) عدد</span>
                                </td>

                                <td class="col-price">
                                    <span class="price-text">$@order.TotalPrice.ToString("N0")</span>
                                </td>

                                <td class="col-status">
                                    <span class="status-badge @statusClass">
                                        @statusText
                                    </span>
                                </td>

                                <td class="col-action">
                                    <form asp-action="UpdateStatus" method="post" class="action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />

                                        <div class="select-wrapper">
                                            <select name="status" class="status-select">
                                                <option value="Pending" selected="@(order.Status == OrderStatus.Pending)">در انتظار پرداخت</option>
                                                <option value="Processing" selected="@(order.Status == OrderStatus.Processing)">در حال پردازش</option>
                                                <option value="Shipped" selected="@(order.Status == OrderStatus.Shipped)">ارسال شده</option>
                                                <option value="Delivered" selected="@(order.Status == OrderStatus.Delivered)">تحویل شده</option>
                                                <option value="Cancelled" selected="@(order.Status == OrderStatus.Cancelled)">لغو شده</option>
                                            </select>
                                        </div>

                                        <button type="submit" class="btn-save" title="ذخیره وضعیت">
                                            <span>ثبت</span>
                                        </button>

                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn-action-icon btn-view" title="مشاهده فاکتور">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>