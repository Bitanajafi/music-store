@model MusicStore.Application.DTOs.Category.UpdateCategoryDto

@section Styles {
    <link rel="stylesheet" href="~/AdminCss/Category.css" asp-append-version="true" />
}


<div class="category-form-container">

    <div class="form-header-wrapper">

        <span class="form-sub-title">
            MANAGEMENT
        </span>

        <h2 class="form-main-title">
            Edit Category
        </h2>

        <p class="form-desc-text">
            Update category information and manage its hierarchy.
        </p>

    </div>


    <div class="premium-form-card">


        <form asp-action="Edit" method="post">

            <input asp-for="Id" type="hidden" />


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4 custom-val-summary">
            </div>


            <div class="mb-4 input-block-custom">

                <label asp-for="Name"
                       class="form-label-premium">
                    Category Name
                </label>


                <div class="input-wrapper-icon">

                    <i class="bi bi-tags field-premium-icon"></i>


                    <input asp-for="Name"
                           class="form-control-premium" />

                </div>


                <span asp-validation-for="Name"
                      class="text-danger small mt-1 d-block">
                </span>

            </div>



            <div class="mb-4 input-block-custom">


                <label asp-for="ParentCategoryId"
                       class="form-label-premium">

                    Parent Category

                </label>



                <div class="input-wrapper-icon">

                    <i class="bi bi-diagram-3 field-premium-icon"></i>


                    <select asp-for="ParentCategoryId"
                            class="form-control-premium">


                        <option value="">
                            Main Category
                        </option>


                        @foreach (var item in ViewBag.MainCategories)
                        {

                            <option value="@item.Id">

                                @item.Name

                            </option>

                        }


                    </select>


                </div>


                <span asp-validation-for="ParentCategoryId"
                      class="text-danger small mt-1 d-block">
                </span>


            </div>





            <!-- Display Order -->


            <div class="mb-4 input-block-custom">


                <label asp-for="DisplayOrder"
                       class="form-label-premium">

                    Display Order

                </label>


                <div class="input-wrapper-icon">

                    <i class="bi bi-sort-numeric-down field-premium-icon"></i>


                    <input asp-for="DisplayOrder"
                           class="form-control-premium"
                           type="number" />


                </div>


                <span asp-validation-for="DisplayOrder"
                      class="text-danger small mt-1 d-block">
                </span>


            </div>






            <div class="form-actions-wrapper">


                <a asp-action="Index"
                   class="btn-form-cancel">

                    <span>
                        Back to List
                    </span>

                </a>




                <button type="submit"
                        class="btn-form-submit">

                    <span>
                        Update Category
                    </span>


                    <i class="bi bi-check-lg"></i>

                </button>


            </div>


        </form>


    </div>


</div>
