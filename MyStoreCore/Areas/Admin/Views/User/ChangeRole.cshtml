@model MyStoreCore.ViewModels.ChangeRoleViewModel
@section Styles {
    <link rel="stylesheet" href="~/AdminCss/user.css" asp-append-version="true" />
}
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "تغییر سطح دسترسی کاربر";
}

<div class="dashboard-wrapper">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold-custom" 
            style="color: var(--sidebar); font-size: 1.6rem; margin: 0;">
            مدیریت سطح دسترسی
        </h2>
            <p class="text-muted small m-0 mt-1">ویرایش نقش و مجوزهای دسترسی کاربر در گالری لگاتو</p>
        </div>
        <a asp-action="Index" class="btn-action-minimalist">
            <i class="bi bi-arrow-right"></i>
            <span>بازگشت به لیست کاربران</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="premium-panel p-4 p-md-5">

                <div class="user-profile-header mb-4 pb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-large">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold m-0" style="color: var(--sidebar);">
                                @Model.FirstName @Model.LastName</h5>
                            <span class="text-muted small text-ltr">@Model.Email</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top-dashed">
                        <span class="text-muted small">نقش فعلی کاربر:</span>
                        @if (Model.CurrentRole == "Admin")
                        {
                            <span class="custom-role-badge is-admin">
                                <i class="bi bi-shield-check"></i>
                                @Model.CurrentRole
                            </span>
                        }
                        else
                        {
                            <span class="custom-role-badge is-member">
                                <i class="bi bi-person"></i>
                                @Model.CurrentRole
                            </span>
                        }
                    </div>
                </div>

                <form asp-action="ChangeRole" method="post" class="custom-form-wrapper">
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-4">
                        <label class="form-label fw-bold small mb-2" style="color: var(--sidebar);">
                            <i class="bi bi-shield-lock me-1" 
                            style="color: var(--gold);"></i> 
                            انتخاب نقش جدید
                        </label>

                        <div class="select-wrapper">
                            <select asp-for="NewRole" class="form-select custom-input">
                                <option value="Customer">
                                    Customer (مشتری / کاربر عادی)
                                    </option>
                                <option value="Admin">
                                    Admin (مدیر کل سیستم)
                                    </option>
                            </select>
                            <i class="bi bi-chevron-down select-icon"></i>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2 pt-2">
                        <button type="submit" class="btn-submit-gold flex-grow-1">
                            <i class="bi bi-check2-circle me-1"></i> 
                            ذخیره تغییرات
                        </button>
                        <a asp-action="Index" class="btn-cancel-style text-center">
                            انصراف
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>

</div>

