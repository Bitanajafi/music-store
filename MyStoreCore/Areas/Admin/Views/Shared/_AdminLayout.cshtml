<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل مدیریت لگاتو</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons-1.13.1/fonts/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminCss/layout.css" />

    <link rel="stylesheet" href="~/css/admin-layout.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="admin-container">

        <aside class="admin-sidebar">
            <button class="sidebar-close d-lg-none" id="closeSidebar">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="sidebar-brand text-center">
                <h2>LEGATO</h2>
                <span class="brand-badge">ADMIN PANEL</span>
            </div>

            <nav class="sidebar-menu">
                <a href="/Admin/Dashboard" class="menu-item active">
                    <i class="bi bi-speedometer2"></i>
                    <span>داشبورد</span>
                </a>
                <a href="/Admin/Product" class="menu-item">
                    <i class="bi bi-box-seam"></i>
                    <span> مدیریت محصولات  </span>
                </a>
                <a href="/Admin/AdminReview" class="menu-item">
                    <i class="bi bi-chat-square-text"></i>
                    <span>مدیریت کامنت ها </span>
                </a>
                <a href="/Admin/Category" class="menu-item">
                    <i class="bi bi-tags"></i>
                    <span>دسته‌بندی‌ها</span>
                </a>
                <a href="/Admin/Brand" class="menu-item">
                    <i class="bi bi-patch-check-fill"></i>
                    <span>برند</span>
                </a>
                <a href="/Admin/Order" class="menu-item">
                    <i class="bi bi-bag-check"></i>
                    <span>سفارشات</span>
                </a>
                <a href="/Admin/Stock" class="menu-item">
                    <i class="bi bi-boxes"></i>
                    <span>انبارداری</span>
                </a>
               
                <a href="/Admin/Coupon" class="menu-item">
                    <i class="bi bi-ticket-perforated"></i>
                    <span>کدهای تخفیف</span>
                </a>

                <a href="/Admin/ProductDiscount" class="menu-item">
                    <i class="bi bi-tags"></i>
                    <span>تخفیف محصولات</span>
                </a>
               

                <a href="/Admin/User" class="menu-item">
                    <i class="bi bi-people"></i>
                    <span>کاربران</span>
                </a>
                <div class="menu-divider"></div>
                <a href="/" class="menu-item target-store">
                    <i class="bi bi-shop"></i>
                    <span>مشاهده فروشگاه</span>
                </a>

            </nav>
        </aside>

        <div class="admin-main-panel">

            <header class="admin-topbar d-flex justify-content-between align-items-center">
                <div class="topbar-right">
                    <button class="btn sidebar-toggle d-lg-none" id="toggleSidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="welcome-text d-none d-md-inline">خوش اومدی ادمین، مدیریت سیستم</span>
                </div>

                <div class="topbar-left d-flex align-items-center gap-4">
                    <div class="admin-profile-info d-flex align-items-center gap-3">
                        <div class="admin-avatar">
                            <i class="bi bi-person-gear"></i>
                        </div>
                        <span class="admin-name">Admin</span>
                    </div>
                    <a href="/Account/Logout" class="btn-admin-logout" title="خروج">
                        <i class="bi bi-box-arrow-left"></i>
                    </a>
                </div>
            </header>

            <main class="admin-content-content">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toggleBtn = document.getElementById("toggleSidebar");
        const closeBtn = document.getElementById("closeSidebar");
        const sidebar = document.querySelector(".admin-sidebar");

        toggleBtn?.addEventListener("click", () => {
            sidebar.classList.add("show");
        });

        closeBtn?.addEventListener("click", () => {
            sidebar.classList.remove("show");
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>