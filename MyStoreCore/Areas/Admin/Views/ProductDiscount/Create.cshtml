
@model MusicStore.Application.DTOs.ProductDiscount.CreateProductDiscountDto

@{
    ViewData["Title"] = "ایجاد تخفیف محصول";
}

@section Styles {
    <link rel="stylesheet" href="~/AdminCss/ProductDiscount.css" asp-append-version="true" />
}

<div class="product-discount-page" dir="rtl">

    <div class="d-flex justify-content-between align-items-end mb-4">

        <a asp-area="Admin"
           asp-controller="ProductDiscount"
           asp-action="Index"
           class="btn-add-product-discount">
            <i class="bi bi-arrow-right me-1"></i> Back to Product Discounts
        </a>

        <div class="text-end">
            <span class="product-discount-subtitle-tag">MANAGEMENT</span>
            <h2 class="product-discount-main-title">Create Discount</h2>
        </div>

    </div>

    <div class="legato-form-card">

        <div class="legato-card-header">
            <h5 class="mb-0 fw-bold">تعریف تخفیف محصول جدید</h5>
        </div>
        </br>
        <div class="legato-card-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger border-0 rounded-3 mb-4">
            </div>

            <form asp-area="Admin"
                  asp-controller="ProductDiscount"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="SKU"
                               class="form-label legato-label">
                            SKU محصول
                        </label>

                        <input asp-for="SKU"
                               class="form-control legato-input"
                               placeholder="مثلاً: GTR-001" />

                        <small class="text-muted d-block mt-1">
                            SKU محصولی که می‌خواهید برای آن تخفیف تعریف کنید.
                        </small>

                        <span asp-validation-for="SKU"
                              class="text-danger small mt-1 d-block">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="DiscountType"
                               class="form-label legato-label">
                            نوع تخفیف
                        </label>

                        <select asp-for="DiscountType"
                                class="form-select legato-input">

                            <option value="0">
                                درصدی
                            </option>

                            <option value="1">
                                مبلغی (تومان)
                            </option>

                        </select>

                        <span asp-validation-for="DiscountType"
                              class="text-danger small mt-1 d-block">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Value"
                               class="form-label legato-label">
                            مقدار تخفیف
                        </label>

                        <input asp-for="Value"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control legato-input"
                               placeholder="مثلاً: 20 یا 50000" />

                        <small class="text-muted d-block mt-1">
                            برای تخفیف درصدی، مقدار بین 1 تا 100 و برای تخفیف مبلغی، مبلغ را وارد کنید.
                        </small>

                        <span asp-validation-for="Value"
                              class="text-danger small mt-1 d-block">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="StartDate"
                               class="form-label legato-label">
                            تاریخ شروع تخفیف
                        </label>

                        <input asp-for="StartDate"
                               type="datetime-local"
                               class="form-control legato-input" />

                        <small class="text-muted d-block mt-1">
                            تخفیف از این تاریخ قابل اعمال خواهد بود.
                        </small>

                        <span asp-validation-for="StartDate"
                              class="text-danger small mt-1 d-block">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="EndDate"
                               class="form-label legato-label">
                            تاریخ پایان تخفیف
                        </label>

                        <input asp-for="EndDate"
                               type="datetime-local"
                               class="form-control legato-input" />

                        <small class="text-muted d-block mt-1">
                            اختیاری؛ خالی گذاشتن یعنی بدون تاریخ پایان.
                        </small>

                        <span asp-validation-for="EndDate"
                              class="text-danger small mt-1 d-block">
                        </span>

                    </div>


                    <div class="col-12">

                        <div class="legato-checkbox-wrapper">

                            <input asp-for="IsActive"
                                   class="form-check-input legato-checkbox"
                                   id="IsActiveCheck" />

                            <label asp-for="IsActive"
                                   class="form-check-label fw-bold ms-2"
                                   for="IsActiveCheck">
                                این تخفیف فعال و قابل اعمال باشد
                            </label>

                        </div>

                    </div>

                </div>


                <hr class="my-4 border-secondary opacity-10" />


                <div class="d-flex justify-content-end gap-2">

                    <button type="submit"
                            class="btn-add-product-discount">

                        <i class="bi bi-plus-lg me-1"></i>
                        ایجاد تخفیف محصول

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

