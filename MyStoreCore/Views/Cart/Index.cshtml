<link href="~/css/layout.css" rel="stylesheet" />
<link href="~/css/cart.css" rel="stylesheet" asp-append-version="true" />
@model MusicStore.Application.DTOs.Cart.CartDto

@{
    ViewData["Title"] = "سبد خرید - لگاتو";
}

<div class="container py-4">

    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <h3 class="fw-bold m-0 d-flex align-items-center gap-2 text-gold fs-4">
            <i class="bi bi-bag-check-fill fs-3"></i>
            <span>سبد خرید شما</span>
        </h3>
        @if (Model?.Items != null && Model.Items.Any())
        {
            <span class="badge bg-outline-gold text-gold fs-7 rounded-pill px-3 py-2 border border-warning border-opacity-25">
                @Model.Items.Count() کالا در سبد
            </span>
        }
    </div>

    @if (Model == null || Model.Items == null || !Model.Items.Any())
    {
        <div class="empty-cart-card text-center my-4 shadow-sm">
            <div class="empty-cart-icon mb-3">
                <i class="bi bi-cart-x text-gold display-3 opacity-50"></i>
            </div>
            <h4 class="fw-bold mb-2 text-white fs-5">سبد خرید شما در حال حاضر خالی است!</h4>
            <p class="text-gold mb-4 max-w-500 mx-auto fs-6 opacity-75">
                به نظر می‌رسد هنوز هیچ ساز یا تجهیزات موسیقی به سبد خرید خود اضافه نکرده‌اید.
            </p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-gold-lg text-decoration-none">
                <i class="bi bi-instrument me-2"></i>
                مشاهده و بررسی محصولات
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            <div class="col-lg-8">
                <div class="cart-glass-card bg-dark-glass shadow-lg mb-4">

                    <div class="card-glass-header table-dark-header">
                        <h6 class="fw-bold mb-0 text-gold d-flex align-items-center gap-2 fs-6">
                            <i class="bi bi-list-stars fs-5"></i>
                            لیست محصولات سبد خرید
                        </h6>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0 text-light border-0">
                                <thead>
                                    <tr class="table-dark-header text-gold">
                                        <th scope="col" class="py-3 px-3 border-0">محصول</th>
                                        <th scope="col" class="py-3 text-center border-0">قیمت واحد</th>
                                        <th scope="col" class="py-3 text-center border-0">تعداد</th>
                                        <th scope="col" class="py-3 text-center border-0">مجموع</th>
                                        <th scope="col" class="py-3 text-end px-3 border-0">عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        var itemTotal = item.UnitPrice * item.Quantity;
                                        <tr class="cart-item-row">

                                            <td class="px-3">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="cart-img-wrapper">
                                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                                                             alt="@item.ProductName" />
                                                    </div>
                                                    <div>
                                                        <h6 class="fw-bold mb-1 text-white fs-6">@item.ProductName</h6>
                                                        <small class="text-white-50 d-block fs-8">کد: @item.SKU</small>
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="text-center font-monospace">
                                                <span class="text-white fw-semibold">@item.UnitPrice.ToString("N0")</span>
                                                <small class="text-white-50 fs-8 d-block">تومان</small>
                                            </td>

                                            <td class="text-center">
                                                <form asp-action="UpdateQuantity" method="post" class="d-inline-flex align-items-center cart-qty-form">
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <input type="number"
                                                           name="quantity"
                                                           value="@item.Quantity"
                                                           min="1"
                                                           onchange="this.form.submit()"
                                                           class="form-control qty-input p-1" />
                                                </form>
                                            </td>

                                            <td class="text-center fw-bold font-monospace text-gold fs-6">
                                                @itemTotal.ToString("N0") <small class="text-gold opacity-75 fw-normal fs-8 d-block">تومان</small>
                                            </td>

                                            <td class="text-end px-3">
                                                <div class="d-flex justify-content-end align-items-center gap-2">

                                                    <a asp-controller="Product"
                                                       asp-action="Details"
                                                       asp-route-id="@item.ProductId"
                                                       class="btn btn-link p-0 border-0 btn-remove-item"
                                                       title="مشاهده محصول">
                                                        <i class="bi bi-eye"></i>
                                                    </a>

                                                    <form asp-action="Remove" method="post" class="d-inline">
                                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                                        <button type="submit"
                                                                class="btn btn-link p-0 border-0 btn-remove-item"
                                                                title="حذف از سبد">
                                                            <i class="bi bi-trash3-fill"></i>
                                                        </button>
                                                    </form>

                                                </div>
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-gold">
                        <i class="bi bi-arrow-right me-1"></i>
                        ادامه خرید
                    </a>

                    <form asp-action="Clear" method="post" onsubmit="return confirm('آیا از خالی کردن تمام سبد خرید اطمینان دارید؟');">
                        <button type="submit" class="btn btn-outline-danger rounded-3 px-3 py-2 fs-7">
                            <i class="bi bi-x-circle me-1"></i>
                            خالی کردن سبد
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="cart-glass-card bg-dark-glass shadow-lg position-sticky" style="top: 90px;">
                    <div class="card-glass-header table-dark-header">
                        <h6 class="fw-bold mb-0 text-gold d-flex align-items-center gap-2 fs-6">
                            <i class="bi bi-receipt fs-5"></i>
                            خلاصه سفارش
                        </h6>
                    </div>
                    <div class="card-body p-3 text-light">
                        @{
                            var grandTotal = Model.Items.Sum(x => x.UnitPrice * x.Quantity);
                        }

                        <div class="d-flex justify-content-between mb-2 text-gold fs-7">
                            <span class="text-white-50">مجموع قیمت کالاها:</span>
                            <span class="font-monospace text-white fw-bold">@grandTotal.ToString("N0") تومان</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3 text-gold fs-7">
                            <span class="text-white-50">هزینه ارسال:</span>
                            <span class="text-success fw-bold">رایگان</span>
                        </div>

                        <hr class="border-secondary border-opacity-25 my-3" />

                        <div class="highlight-total-box mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-white fs-6">مبلغ قابل پرداخت:</span>
                                <div class="text-end">
                                    <span class="fw-bold fs-4 text-gold font-monospace d-block">@grandTotal.ToString("N0")</span>
                                    <small class="text-gold opacity-75 fs-8">تومان</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <form asp-controller="Orders" asp-action="Checkout" method="get">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-gold-lg w-100 py-2 text-center shadow">
                                    ثبت سفارش و پرداخت
                                    <i class="bi bi-credit-card-2-back ms-1"></i>
                                </button>
                            </form>
                        </div>
                        <div class="mt-3 pt-2 border-top border-secondary border-opacity-10 text-center text-gold fs-8">
                            <i class="bi bi-shield-check text-gold me-1"></i>
                            تضمین اصالت و ضمانت بازگشت کالا
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>