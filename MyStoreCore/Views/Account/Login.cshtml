<link href="~/css/layout.css" rel="stylesheet" />

@model MusicStore.Web.ViewModels.Account.LoginViewModel
<div class="container py-5 mt-4" dir="ltr">
    <div class="login-wrapper">
        <div class="row g-0 align-items-stretch">

            <div class="col-lg-6">
                <div class="login-form-box">

                    <span class="login-sub-title">WELCOME BACK</span>

                    <h1 class="login-main-title">Login</h1>

                    <p class="login-desc">
                        Enter your credentials to access your private studio account.
                    </p>

                    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "mt-4" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <div class="mb-4">
                            <label class="form-label-simple">Email Address</label>

                            @Html.TextBoxFor(m => m.Email, new
                            {
                                @class = "form-control-simple",
                                                type = "email",
                                                placeholder = "name@example.com",
                                                required = "required"
                                                })

                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        <label class="form-label-simple">Password</label>

                        @Html.PasswordFor(m => m.Password, new
                                                {
                                @class = "form-control-simple",
                                                placeholder = "Password",
                                                required = "required"
                                                })

                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4 login-options">

                        <label class="d-flex align-items-center gap-2 style-checkbox">
                            @Html.CheckBoxFor(m => m.RememberMe)
                            <span>Remember Me</span>
                        </label>

                       
                        <a href="#" class="forgot-link">
                            Forgot Password?
                        </a>

                    </div>

                    <button type="submit" class="btn btn-login-submit">
                        LOGIN
                    </button>

                    <p class="register-redirect mt-4">
                        Don't have an account?
                        <a href="@Url.Action("Register", "Account")">
                            Create One
                        </a>
                    </p>
                                        }

                </div>
            </div>

            <div class="col-lg-6 d-none d-lg-block">
                <div class="login-info-box h-100 d-flex flex-column justify-content-center text-center">

                    <div class="px-5">

                        <h2 class="info-brand-title">LEGATO</h2>

                        <div class="brand-divider"></div>

                        <p class="info-brand-text">
                            "Where the fine art of luthiery meets the passion of the player."
                        </p>

                        <p class="info-brand-subtext mt-3">
                            Join our community of collectors and artists.
                        </p>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>