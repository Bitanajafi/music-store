@model IEnumerable<MusicStore.Application.DTOs.Order.OrderDto>
@using MusicStore.Domain.Enum
@{
    ViewData["Title"] = "سفارش‌های من";
}

<link href="~/css/layout.css" rel="stylesheet" />
<link href="~/css/order.css" rel="stylesheet" />

<div class="checkout-luxury-page py-4 py-md-5">
    <div class="container">

        <div class="checkout-page-header mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h2 class="page-title text-gold-gradient fw-bold mb-1 fs-4">
                    <i class="bi bi-bag-check-fill text-gold me-2"></i>
                    سفارش‌های من
                </h2>
                <p class="page-subtitle text-white-50 fs-7 m-0">
                    تاریخچه و وضعیت تمام سفارش‌های ثبت‌شده شما
                </p>
                <br />
               
            </div>

            <div>
                <span class="badge bg-gold bg-opacity-10 text-gold border border-gold border-opacity-25 px-3 py-2 rounded-pill fs-7 shadow-sm">
                    تعداد کل سفارش‌ها: @(Model?.Count() ?? 0)
                </span>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="checkout-glass-card text-center py-5">
                <div class="card-glass-body py-4">
                    <div class="mb-3">
                        <i class="bi bi-bag-x text-gold display-3 opacity-50"></i>
                    </div>

                    <h5 class="fw-bold text-white mb-2 fs-5">
                        هنوز سفارشی ثبت نکرده‌اید
                    </h5>

                    <p class="text-white-50 fs-7 mb-4">
                        سفارش‌های شما پس از تکمیل مراحل خرید، در این بخش قابل مشاهده و پیگیری خواهند بود.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-gold-lg px-4 py-2 fs-7 d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-shop me-2"></i>
                        مشاهده و خرید محصولات
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var order in Model.OrderByDescending(x => x.CreatedAt))
                {
                    <div class="checkout-glass-card hover-lift transition-all">
                        <div class="card-glass-body p-3 p-md-4">
                            <div class="row align-items-center g-3">

                                <div class="col-6 col-md-4 col-lg-2">
                                    <small class="text-white-50 fs-8 d-block mb-1">شماره سفارش</small>
                                    <span class="fw-bold text-white fs-6">#@order.Id</span>
                                </div>

                                <div class="col-6 col-md-4 col-lg-2">
                                    <small class="text-white-50 fs-8 d-block mb-1">تاریخ ثبت</small>
                                    <div class="fw-semibold text-white fs-7">
                                        @order.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                                    </div>
                                    <small class="text-white-50 fs-8">
                                        ساعت @order.CreatedAt.ToLocalTime().ToString("HH:mm")
                                    </small>
                                </div>

                                <div class="col-6 col-md-4 col-lg-2">
                                    <small class="text-white-50 fs-8 d-block mb-1">وضعیت سفارش</small>
                                    @switch (order.Status)
                                    {
                                        case MusicStore.Domain.Enum.OrderStatus.Pending:
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2.5 py-1.5 rounded-pill fs-8">
                                                <i class="bi bi-hourglass-split me-1"></i> در انتظار پرداخت
                                            </span>
                                            break;

                                        case MusicStore.Domain.Enum.OrderStatus.Paid:
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1.5 rounded-pill fs-8">
                                                <i class="bi bi-check-circle-fill me-1"></i> پرداخت شده
                                            </span>
                                            break;

                                        case MusicStore.Domain.Enum.OrderStatus.Shipped:
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2.5 py-1.5 rounded-pill fs-8">
                                                <i class="bi bi-truck me-1"></i> ارسال شده
                                            </span>
                                            break;

                                        case MusicStore.Domain.Enum.OrderStatus.Delivered:
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1.5 rounded-pill fs-8">
                                                <i class="bi bi-house-check-fill me-1"></i> تحویل داده شده
                                            </span>
                                            break;

                                        case MusicStore.Domain.Enum.OrderStatus.Cancelled:
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2.5 py-1.5 rounded-pill fs-8">
                                                <i class="bi bi-x-circle-fill me-1"></i> لغو شده
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary bg-opacity-10 text-white border border-secondary border-opacity-25 px-2.5 py-1.5 rounded-pill fs-8">
                                                @order.Status
                                            </span>
                                            break;
                                    }
                                </div>

                                <div class="col-6 col-md-4 col-lg-2">
                                    <small class="text-white-50 fs-8 d-block mb-1">مبلغ کالاها</small>
                                    <div class="fw-semibold text-white fs-7">
                                        @order.SubTotal.ToString("N0")
                                        <small class="text-white-50 fs-8">تومان</small>
                                    </div>
                                </div>

                                <div class="col-6 col-md-4 col-lg-2">
                                    <small class="text-white-50 fs-8 d-block mb-1">سود شما از خرید</small>
                                    @if (order.DiscountAmount > 0)
                                    {
                                        <div class="text-danger fw-semibold fs-7">
                                            -@order.DiscountAmount.ToString("N0")
                                            <small class="text-white-50 fs-8">تومان</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-white-50 fs-8">بدون تخفیف</div>
                                    }
                                </div>

                                <div class="col-6 col-md-4 col-lg-2">
                                    <small class="text-white-50 fs-8 d-block mb-1">مبلغ پرداختی</small>
                                    <div class="fw-bold fs-6 text-gold glow-text">
                                        @order.TotalPrice.ToString("N0")
                                        <small class="text-gold fs-8">تومان</small>
                                    </div>
                                </div>

                                <div class="col-12 mt-3 pt-2 border-top border-white border-opacity-10 d-flex justify-content-end align-items-center gap-2">
                                    <a asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-outline-gold btn-sm px-3 py-1.5 fs-7 rounded-3 d-inline-flex align-items-center gap-2">
                                        <i class="bi bi-eye"></i>
                                        مشاهده جزئیات سفارش
                                    </a>

                                    @if (order.Status == OrderStatus.Pending && order.Payment?.Status != PaymentStatus.Paid)
                                    {
                                        <form asp-controller="Orders"
                                              asp-action="Cancel"
                                              asp-route-id="@order.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('آیا از لغو این سفارش مطمئن هستید؟');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm px-3 py-1.5 fs-7 rounded-3 d-inline-flex align-items-center gap-2">
                                                <i class="bi bi-x-circle"></i>
                                                لغو سفارش
                                            </button>

                                        </form>
                                    }
                                </div>


                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>