@model MyStoreCore.ViewModels.Order.CheckoutViewModel
<link href="~/css/order.css" rel="stylesheet" />
<link href="~/css/layout.css" rel="stylesheet" />
@{
    ViewData["Title"] = "تکمیل سفارش";
    var cart = Model.Cart;

    var subTotal = Model.SubTotal > 0
        ? Model.SubTotal
        : cart?.TotalPrice ?? 0;

    var discountAmount = Model.DiscountAmount;

    var finalPrice = Model.FinalPrice > 0
        ? Model.FinalPrice
        : subTotal - discountAmount;
}

<div class="checkout-luxury-page py-4 py-md-5">
    <div class="container">

        <div class="checkout-page-header mb-4 text-center text-lg-start">
            <h2 class="page-title text-gold-gradient fw-bold mb-2 fs-4">
                <i class="bi bi-shield-check text-gold me-2"></i>
                تکمیل و ثبت نهایی سفارش
            </h2>
            <p class="page-subtitle text-white-50 fs-7 m-0">
                اطلاعات ارسال را وارد کنید و پیش‌فاکتور خرید خود را بررسی کنید.
            </p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>



        <div class="row g-4">

            <div class="col-lg-7 col-xl-8">

                <form asp-controller="Orders" asp-action="Create" method="post" id="checkout-form">
                    @Html.AntiForgeryToken()



                    <div class="checkout-glass-card mb-4">
                        <div class="card-glass-header">
                            <div class="header-gold-icon">
                                <i class="bi bi-person-vcard"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 text-white fw-bold fs-6">اطلاعات تحویل‌گیرنده</h5>
                                <small class="text-gold opacity-75 fs-8">مشخصات شخصی دریافت‌کننده مرسوله</small>
                            </div>
                        </div>

                        <div class="card-glass-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="checkout-label">
                                        <i class="bi bi-person text-gold"></i>
                                        نام و نام خانوادگی
                                    </label>
                                    <input asp-for="ShippingInfo.FullName" class="form-control dark-glass-input" placeholder="مثلاً: بیتا نجفی " />
                                    <span asp-validation-for="ShippingInfo.FullName" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="checkout-label">
                                        <i class="bi bi-telephone text-gold"></i>
                                        شماره تماس
                                    </label>
                                    <input asp-for="ShippingInfo.PhoneNumber" class="form-control dark-glass-input text-start" dir="ltr" placeholder="09xxxxxxxxx" />
                                    <span asp-validation-for="ShippingInfo.PhoneNumber" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>





                    <div class="checkout-glass-card mb-4">
                        <div class="card-glass-header">
                            <div class="header-gold-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 text-white fw-bold fs-6">نشانی و آدرس ارسال</h5>
                                <small class="text-gold opacity-75 fs-8">محل دقیق جهت تحویل سفارش</small>
                            </div>
                        </div>

                        <div class="card-glass-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="checkout-label">
                                        <i class="bi bi-building text-gold"></i>
                                        شهر
                                    </label>
                                    <input asp-for="ShippingInfo.City" class="form-control dark-glass-input" placeholder="مثلاً: تهران" />
                                    <span asp-validation-for="ShippingInfo.City" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="checkout-label">
                                        <i class="bi bi-mailbox text-gold"></i>
                                        کد پستی
                                    </label>
                                    <input asp-for="ShippingInfo.PostalCode" class="form-control dark-glass-input text-start" dir="ltr" placeholder="۱۰ رقم بدون فاصله" />
                                    <span asp-validation-for="ShippingInfo.PostalCode" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-12">
                                    <label class="checkout-label">
                                        <i class="bi bi-map text-gold"></i>
                                        آدرس کامل پستی
                                    </label>
                                    <textarea asp-for="ShippingInfo.Address" class="form-control dark-glass-input" rows="2" placeholder="خیابان اصلی، کوچه، پلاک، واحد"></textarea>
                                    <span asp-validation-for="ShippingInfo.Address" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>




                    <div class="checkout-glass-card">
                        <div class="card-glass-header">
                            <div class="header-gold-icon">
                                <i class="bi bi-bag-check-fill"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 text-white fw-bold fs-6">اقلام سفارش</h5>
                                <small class="text-gold opacity-75 fs-8">مرور محتویات سبد خرید</small>
                            </div>
                        </div>


                        <div class="card-glass-body p-3">
                            <div class="cart-items-wrapper d-flex flex-column gap-2">
                                @if (cart?.Items != null && cart.Items.Any())
                                {
                                    foreach (var item in cart.Items)
                                    {
                                        <div class="cart-item-row p-2 px-3 d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="cart-img-wrapper">
                                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)" alt="@item.ProductName" class="cart-item-img" />
                                                </div>
                                                <div class="d-flex flex-column justify-content-center">
                                                    <h6 class="fw-bold text-white mb-1 fs-7 cart-item-title">@item.ProductName</h6>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge-quantity">تعداد: @item.Quantity</span>
                                                        <small class="text-white-50 fs-8">@item.UnitPrice.ToString("N0") تومان</small>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="text-end ms-2">
                                                <span class="fw-bold fs-7 text-gold d-block">@item.TotalPrice.ToString("N0")</span>
                                                <small class="text-white-50 fs-8">تومان</small>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>


                    </div>

                    <input type="hidden" asp-for="CouponCode" />
                </form>

            </div>



            <div class="col-lg-5 col-xl-4">
                <div class="sticky-checkout-summary">
                    <div class="checkout-glass-card">

                        <div class="card-glass-header">
                            <div class="header-gold-icon">
                                <i class="bi bi-receipt-cutoff"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 text-white fw-bold fs-6">خلاصه صورت‌حساب</h5>
                                <small class="text-gold opacity-75 fs-8">بررسی نهایی مبلغ سفارش</small>
                            </div>
                        </div>

                        <div class="card-glass-body p-3 p-md-4">

                            <form asp-controller="Orders" asp-action="ApplyCoupon" method="post" class="mb-3">
                                @Html.AntiForgeryToken()
                                <label asp-for="CouponCode" class="checkout-label mb-2">
                                    <i class="bi bi-ticket-perforated text-gold"></i>
                                    کد تخفیف
                                </label>
                                <div class="d-flex gap-2">
                                    <input asp-for="CouponCode" class="form-control dark-glass-input text-start" dir="ltr" autocomplete="off" placeholder="مثلاً: MUSIC20" />
                                    <button type="submit" class="btn btn-outline-gold px-3">
                                        <i class="bi bi-check2-circle me-1"></i>
                                        اعمال
                                    </button>
                                </div>
                                <span asp-validation-for="CouponCode" class="text-danger small mt-1 d-block"></span>
                            </form>

                            <hr class="border-secondary opacity-20 my-3" />

                            <div class="d-flex justify-content-between align-items-center mb-2 fs-7">
                                <span class="text-white-50">مبلغ کالاها:</span>
                                <span class="text-white fw-semibold">
                                    @subTotal.ToString("N0")
                                    <small class="text-white-50">تومان</small>
                                </span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2 fs-7">
                                <span class="text-white-50">هزینه ارسال:</span>
                                <span class="text-success fw-bold">رایگان</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3 fs-7">
                                <span class="text-white-50">تخفیف:</span>
                                @if (discountAmount > 0)
                                {
                                    <span class="text-success fw-bold">- @discountAmount.ToString("N0") تومان</span>
                                }
                                else
                                {
                                    <span class="text-white-50">بدون تخفیف</span>
                                }
                            </div>

                            <hr class="border-secondary opacity-20 my-3" />

                            <div class="p-3 highlight-total-box mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-white fs-7">مبلغ نهایی</span>
                                    <div class="text-end">
                                        <span class="fs-4 fw-bold text-gold glow-text">@finalPrice.ToString("N0")</span>
                                        <span class="text-gold fw-bold ms-1 fs-8">تومان</span>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" form="checkout-form" class="btn btn-gold-lg w-100 py-2 fs-6">
                                <i class="bi bi-credit-card-2-back-fill fs-6"></i>
                                پرداخت و ثبت نهایی سفارش
                            </button>

                            <div class="mt-3 pt-2 border-top border-secondary border-opacity-10 text-center">
                                <p class="text-gold fs-8 m-0">
                                    <i class="bi bi-shield-lock text-gold-link me-1"></i>
                                    پرداخت امن از طریق تمامی کارت‌های شتاب
                                </p>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}