<div id="heroCarousel"
     class="carousel slide carousel-fade hero-slider"
     data-bs-ride="carousel"
     data-bs-interval="2500">
    <div class="carousel-indicators hero-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <div class="carousel-inner h-100">

        <div class="carousel-item active h-100 hero-slide-1">
            <div class="hero-overlay overlay-slide-1">
                <div class="container">
                    <div class="hero-content slide-content-1">
                        <span class="hero-subtitle subtitle-1">انتخاب ویژه و حرفه‌ای</span>
                        <h1 class="hero-title title-1">آغاز یک صدای بی‌نقص، از اینجا</h1>
                        <p class="hero-description desc-1">
                            شاهکارهای کلاسیک ماندگار تا مدرن‌ترین ابزارهای خلق هنر
                        </p>
                        <div class="hero-actions">
                            <a href="/Product/Index" class="btn btn-premium-gold btn-1">
                                <span>خرید آنلاین</span>
                                <i class="bi bi-arrow-left"></i>
                            </a>
                            <a href="#categories" class="btn btn-premium-outline">مشاهده دسته‌ها</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="carousel-item h-100 hero-slide-2">
            <div class="hero-overlay overlay-slide-2">
                <div class="container">
                    <div class="hero-content slide-content-2">
                        <span class="hero-subtitle subtitle-2">LEGATO SPECIAL SELECTION</span>
                        <h1 class="hero-title title-2">هنر نواختن، لذت شنیدن</h1>
                        <p class="hero-description desc-2">
                            مجموعه‌ای دست‌چین شده از برترین سازهای کلاسیک و مدرن برای هنرمندانی که به کیفیت اهمیت می‌دهند
                        </p>
                        <div class="hero-actions">
                            <a href="/Product/Index" class="btn btn-premium-gold btn-2">
                                <span>مشاهده سازها</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="carousel-item h-100 hero-slide-3">
            <div class="hero-overlay overlay-slide-3">
                <div class="container">
                    <div class="hero-content slide-content-3">

                        <h1 class="hero-title title-3">
                            جادوی کلاویه‌های سیاه و سفید
                        </h1>
                        <p class="hero-description desc-3">
                            از پیانوهای دیجیتال هوشمند تا مدل‌های آکوستیک اصیل؛<br> ابزاری بی‌نظیر برای تبدیل احساساتِ نگفته به زیباترین ملودی‌ها
                        </p>
                        <div class="hero-actions">
                            <a href="/Product/Index?categoryId=5" class="btn btn-premium-gold btn-3">
                                <span>مشاهده کلکسیون پیانو</span>
                            </a>
                            <a href="/Home/Contact" class="btn btn-premium-outline">مشاوره رایگان خرید</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">قبلی</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">بعدی</span>
    </button>
</div>






